public void migrateSchema(
        String entity,
        int fromSchemaVersion,
        int toSchemaVersion) {

    createMigrationBackup();

    preservePreviousSchemaHistory(fromSchemaVersion);

    initializeActiveHistory(toSchemaVersion);

    updateMainSchema(toSchemaVersion);

    migrateMainData(fromSchemaVersion, toSchemaVersion);

    generateReconciliationReport();

    applySchemaConstraints(toSchemaVersion);

    completeMigration();


